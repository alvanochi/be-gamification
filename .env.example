PGHOST=localhost
PGPORT=
PGDATABASE=
PGUSER=
PGPASSWORD=

ACCESS_TOKEN_KEY=
REFRESH_TOKEN_KEY=
ACCESS_TOKEN_AGE=180
REFRESH_TOKEN_AGE=10080

# Cloudflare R2 — penyimpanan bukti misi.
# R2_PUBLIC_DOMAIN harus hostname PUBLIK tanpa skema, mis. pub-xxxx.r2.dev atau
# custom domain. Endpoint S3 (<bucket>.<account>.r2.cloudflarestorage.com) TIDAK
# bisa dipakai di sini karena hanya melayani request bertanda tangan.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_DOMAIN=

# BR-04 Time Box — jendela 12 jam harian untuk seluruh aktivitas pengerjaan.
# Format HH:MM waktu lokal acara. Kosongkan keduanya untuk menonaktifkan.
EVENT_WINDOW_START=06:00
EVENT_WINDOW_END=18:00
# Offset zona waktu acara terhadap UTC (WIB = 7).
EVENT_TIMEZONE_OFFSET=7

# Kunci bersama untuk pihak eksternal yang mengirim data media sosial
# (jumlah postingan & nett likes/share). Minimal 16 karakter.
# Tanpa ini, seluruh jalur /api/external menolak permintaan.
# Buat dengan: openssl rand -hex 32
EXTERNAL_API_KEY=
